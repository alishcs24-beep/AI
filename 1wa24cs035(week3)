        "import heapq\n",
        "\n",
        "\n",
        "goal = (1, 2, 3,\n",
        "        4, 5, 6,\n",
        "        7, 8, 0)\n",
        "\n",
        "\n",
        "\n",
        "def misplaced_tiles(state):\n",
        "    count = 0\n",
        "    for i in range(9):\n",
        "        if state[i] != 0 and state[i] != goal[i]:\n",
        "            count += 1\n",
        "    return count\n",
        "\n",
        "\n",
        "\n",
        "def manhattan_distance(state):\n",
        "    distance = 0\n",
        "\n",
        "    for i in range(9):\n",
        "        tile = state[i]\n",
        "\n",
        "        if tile != 0:\n",
        "            current_row, current_col = divmod(i, 3)\n",
        "            goal_index = goal.index(tile)\n",
        "            goal_row, goal_col = divmod(goal_index, 3)\n",
        "\n",
        "            distance += (\n",
        "                abs(current_row - goal_row)\n",
        "                + abs(current_col - goal_col)\n",
        "            )\n",
        "\n",
        "    return distance\n",
        "\n",
        "\n",
        "\n",
        "def get_neighbors(state):\n",
        "    neighbors = []\n",
        "    zero = state.index(0)\n",
        "    row, col = divmod(zero, 3)\n",
        "\n",
        "    moves = []\n",
        "    if row > 0:\n",
        "        moves.append(zero - 3)\n",
        "    if row < 2:\n",
        "        moves.append(zero + 3)\n",
        "    if col > 0:\n",
        "        moves.append(zero - 1)\n",
        "    if col < 2:\n",
        "        moves.append(zero + 1)\n",
        "\n",
        "    for pos in moves:\n",
        "        new_state = list(state)\n",
        "        new_state[zero], new_state[pos] = (\n",
        "            new_state[pos], new_state[zero]\n",
        "        )\n",
        "        neighbors.append(tuple(new_state))\n",
        "\n",
        "    return neighbors\n",
        "\n",
        "\n",
        "def astar(start, heuristic):\n",
        "    pq = []\n",
        "    heapq.heappush(pq, (heuristic(start), 0, start, [start]))\n",
        "\n",
        "    best_cost = {start: 0}\n",
        "\n",
        "    while pq:\n",
        "        f, g, state, path = heapq.heappop(pq)\n",
        "\n",
        "        if g != best_cost.get(state):\n",
        "            continue\n",
        "\n",
        "        if state == goal:\n",
        "            print(\"Goal State Reached!\")\n",
        "            print(\"Total moves:\", g)\n",
        "            print(\"Path:\")\n",
        "            for step in path:\n",
        "                print_state(step)\n",
        "            return\n",
        "\n",
        "        for neighbor in get_neighbors(state):\n",
        "            new_g = g + 1\n",
        "\n",
        "            if new_g < best_cost.get(neighbor, float(\"inf\")):\n",
        "                best_cost[neighbor] = new_g\n",
        "                new_f = new_g + heuristic(neighbor)\n",
        "\n",
        "                heapq.heappush(\n",
        "                    pq,\n",
        "                    (new_f, new_g, neighbor, path + [neighbor])\n",
        "                )\n",
        "\n",
        "    print(\"No solution found.\")\n",
        "\n",
        "\n",
        "\n",
        "def print_state(state):\n",
        "    for i in range(0, 9, 3):\n",
        "        print(state[i:i + 3])\n",
        "    print()\n",
        "\n",
        "\n",
        "start = (1, 2, 3,\n",
        "         4, 0, 6,\n",
        "         7, 5, 8)\n",
        "\n",
        "print(\"A* with Misplaced Tiles Heuristic\")\n",
        "astar(start, misplaced_tiles)\n",
        "\n",
        "print(\"A* with Manhattan Distance Heuristic\")\n",
        "astar(start, manhattan_distance)"
      ]
